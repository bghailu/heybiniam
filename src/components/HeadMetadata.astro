---
import { Font } from "astro:assets";
import { SEO } from "astro-seo";
import "@/styles/global.css";

const defaultKeywords = [
  "Biniam Hailu",
  "applied AI engineer",
  "AI engineer",
  "computer science",
  "LLM applications",
  "Pacific Lutheran University",
  "mathematician",
];
const {
  title = "biniam",
  description = "Portfolio of Biniam Hailu, a computer science and math student at Pacific Lutheran University building applied AI systems — agentic workflows, RAG pipelines, and fine-tuned LLMs.",
  keywords = defaultKeywords,
  img = {
    url: `/favicon/android-chrome-512x512.png`,
    alt: "Biniam Hailu's site icon.",
    width: 512,
    height: 512,
  },
} = Astro.props as Props;

export type Props = {
  title?: string;
  description?: string;
  keywords?: string | string[];
  img?: {
    url?: string;
    alt?: string;
    width?: number;
    height?: number;
  };
};

const keywordTags = (Array.isArray(keywords) ? keywords : keywords.split(","))
  .map((keyword) => keyword.trim())
  .filter(Boolean);

const imageDetails = {
  url: Astro.url.origin + img.url,
  secureUrl: Astro.url.origin + img.url,
  alt: img.alt,
  width: img.width,
  height: img.height,
};

const extendMeta = {
  // extending the default meta tags
  meta: [
    {
      name: "twitter:image",
      content: imageDetails.url,
    },
    { name: "twitter:title", content: title },
    { name: "twitter:description", content: description },
  ],
};

---

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<Font cssVariable="--font-family-lexend" preload />
<Font cssVariable="--font-family-manrope" preload />

<link href="https://github.com/bghailu" rel="me" />

<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta http-equiv="Accept-CH" content="DPR, Viewport-Width, Width" />
<meta name="viewport" content="width=device-width" />
<meta name="color-scheme" content="dark" />
<meta name="robots" content="index, follow, noimageindex" />
<meta name="theme-color" content="#000000" />

<SEO
  title={/Biniam/i.test(title) ? title : title + " — Biniam Hailu"}
  {description}
  openGraph={{
    image: { ...imageDetails },
    basic: {
      title,
      type: "website",
      image: imageDetails.url,
    },
    article: {
      authors: ["Biniam Hailu"],
      tags: keywordTags,
    },
    optional: {
      description,
      siteName: "Biniam Hailu",
      locale: "en_US",
    },
  }}
  twitter={{
    card: "summary_large_image",
  }}
  extend={extendMeta}
/>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Biniam Hailu",
    url: "https://heybiniam.com/",
    image: "https://heybiniam.com/favicon/android-chrome-512x512.png",
    description:
      "Portfolio for Biniam Hailu. It contains some of his projects, and a little about him.",
    sameAs: [
      "https://heybiniam.com",
      "https://www.linkedin.com/in/bghailu",
      "https://github.com/bghailu",
    ],
    about: { "@type": "Person", name: "Portfolio of Biniam Hailu" },
    mainEntity: { "@type": "Article", "@id": "https://heybiniam.com/#content" },
    inLanguage: "en",
    author: { "@type": "Person", name: "Biniam Hailu" },
    publisher: {
      "@type": "Person",
      name: "Biniam Hailu",
      logo: {
        "@type": "ImageObject",
        url: "https://heybiniam.com/favicon/android-chrome-512x512.png",
      },
    },
    copyrightYear: new Date().getFullYear().toString(),
    copyrightHolder: {
      "@type": "Person",
      name: "Biniam Hailu",
      logo: {
        "@type": "ImageObject",
        url: "https://heybiniam.com/favicon/android-chrome-512x512.png",
      },
    },
  })}
/>
