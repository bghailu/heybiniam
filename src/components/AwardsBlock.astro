---
import { Icon } from "astro-icon/components";
---

<div class="awards-block">
  <div class="content">
    {
      () => {
        let cols = [
          [
            "mdi:certificate",
            "Applied AI Engineering Certificate",
            "CodePath x Anthropic • May 2026",
          ],
          [
            "mdi:trophy",
            "Washington State Gold Medalist, ICPC PACNW",
            "University of Washington Tacoma • Nov. 2024",
          ],
          [
            "mdi:trophy",
            "Dean's List",
            "Pacific Lutheran University • All Semesters",
          ],
        ];
        return cols.map((col) => {
          let [icon, title, description] = col;
          return (
            <div class="award">
              <div class="icon-container">
                <Icon name={icon} />
              </div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          );
        });
      }
    }
  </div>
</div>

<style>
  @reference "../styles/global.css";

  .awards-block {
    @apply bg-gray-900 sm:rounded-3xl;
    @apply container max-w-[85ch];
    @apply px-2 py-10 lg:px-10;

    .content {
      @apply grid sm:grid-cols-2 gap-6 lg:gap-12 max-w-full;
    }
  }

  .award {
    @apply flex flex-col items-center px-0 sm:px-2 lg:px-6;
  }

  .icon-container {
    @apply bg-primary/30 p-6 inline-block rounded-full;
    @apply text-primary;
    svg {
      @apply w-6 h-6;
    }
  }
</style>
