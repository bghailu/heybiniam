---
import HomepageLayout from "../layouts/HomepageLayout.astro";
import HeroBanner from "../components/HeroBanner.astro";
import AwardsBlock from "../components/AwardsBlock.astro";
import Card from "../components/Card.astro";
import Anchor from "../components/Anchor.astro";

import { slug as slugger } from "@/utils/slug";

export const prerender = true;

let sizes = `(max-width: 300px) 270px, (max-width: 350px) 320px, (max-width: 450px) 420px, (max-width: 630px) 600px, (max-width: 750px) 350px, (max-width: 850px) 400px, (max-width: 1024px) 500px, 350px`;
---

<HomepageLayout>
  <HeroBanner slot="hero" />

  <section data-nav-section="about">
    <div class="content">
      <h2 id="about">About.</h2>
      <p>
        Hey, I'm Biniam Hailu, an AI Engineer and summa cum laude graduate of 
        Pacific Lutheran University, where I earned degrees in Computer Science and Applied Mathematics.
        
        When I'm not coding, you'll find me watching movies, losing tennis matches 
        I swear I almost won, or out with friends.
      </p>
      <p>
      I build agentic systems, RAG pipelines, and fine-tuned LLMs that actually hold up in production, 
        sitting on solid backend and cloud foundations. I like new tools, hard problems, and the quiet
         satisfaction of turning a half-formed idea into something people can use.
      </p>
      <p>
      When I'm not coding, you'll find me watching movies, losing tennis matches 
        I swear I almost won, or out with friends.
      </p>

      <p>
        Welcome to my corner of the web.

      </p>


    </div>

    <div class="content">
      <h3 class="nav-item" id="experience">Experience</h3>
      <ul class="not-prose flex flex-col gap-6 pl-0 list-none">
        {
          () => {
            let experience = [
              {
                company: "Pacific Lutheran University",
                role: "Data Structures Teaching Assistant",
                period: "Sep. 2025 -- Present",
              },
              {
                company: "churchme",
                role: "Software Engineer Intern",
                period: "May 2025 -- Aug. 2025",
              },
              {
                company: "Techfinity Solutions",
                role: "Software Developer Intern",
                period: "June 2024 -- Aug. 2024",
              },
              {
                company: "Pacific Lutheran University",
                role: "Student Technician",
                period: "Sep. 2023 -- Present",
              },
            ];

            return experience.map(({ company, role, period }) => (
              <li>
                <strong class="text-primary">{company}</strong> — {role}
                <span class="block text-sm opacity-70">{period}</span>
              </li>
            ));
          }
        }
      </ul>
    </div>

    <div class="content">
      <h3 class="nav-item" id="skills">Skills</h3>
      <p>
        <strong class="text-primary">AI &amp; AI-Native Tooling:</strong> RAG,
        Agentic &amp; Multi-Agent Systems (LangGraph, Pydantic-AI), LLM
        Fine-Tuning (QLoRA, Unsloth), vLLM, FAISS, pgvector, Tool/Function
        Calling, Hallucination Guardrails, Claude Code.
      </p>
      <p>
        <strong class="text-primary">Languages &amp; Frameworks:</strong> Python,
        TypeScript, Go, Java, Next.js, React, Node.js, FastAPI, Flask, Gin, Pandas.
      </p>
      <p>
        <strong class="text-primary">Cloud, Infrastructure &amp; Data:</strong> AWS
        (EC2, Lambda, DynamoDB, S3, CDK), Azure (App Service, Entra ID), Firebase,
        Docker, PostgreSQL, MongoDB, Redis, REST APIs, CI/CD, Git, GitHub.
      </p>
    </div>

    <div class="content">
      <h3 id="awards">Awards</h3>
      <p>
        A couple of highlights so far: completing the Applied AI Engineering
        Certificate through CodePath x Anthropic, winning gold at the ICPC
        Pacific Northwest regional, and landing on Pacific Lutheran
        University's Dean's List every semester.
      </p>
    </div>

    <div class="py-6">
      <AwardsBlock />
    </div>
  </section>

  <section data-nav-section="projects">
    <div class="content">
      <h2 id="projects">Featured Projects.</h2>
    </div>
    <div class="container px-5 max-w-3xl mx-auto">
      <div class="grid sm:grid-cols-2 gap-6">
        {
          () => {
            let projects = {
              "Deal Hunter": {
                image: { blank: true },
                description:
                  "Autonomous multi-agent workflow (LangGraph, Pydantic-AI) that ingests live listings, predicts fair market value with a fine-tuned Qwen3-8B model served on vLLM, and surfaces mispriced bargains in real time.",
                link: "https://github.com/bghailu",
              },

              "Tatari AI": {
                image: {
                  src: "cloudinary/tatari",
                  alt: "Screenshot of the Tatari AI academic advisor.",
                },
                description:
                  "Full-stack AI academic advisor (Next.js, FastAPI, GPT-4.1) with a pgvector-backed agentic memory system that analyzes academic records and delivers personalized, RAG-grounded recommendations.",
                link: "https://github.com/bghailu",
              },

              RentLink: {
                image: {
                  src: "cloudinary/rentlink",
                  alt: "Screenshot of the RentLink web app.",
                },
                description:
                  "A university exclusive platform on AWS EC2 designed to simplify student subleases.",
                link: "https://www.rentlink.space/",
              },

              "Safe Bites": {
                image: {
                  src: "cloudinary/safebites",
                  alt: "Screenshot of the Safe Bites Android app.",
                },
                description:
                  "AI-powered native Android application that scans food labels and flags ingredients violating user-defined dietary restrictions using the Gemini API.",
                link: "https://www.safebites.fit/",
              },
            };

            return Object.keys(projects).map((name) => {
              let { description, link, image, showTitle } = projects[name];
              return (
                <Card
                  img={Object.assign(
                    {
                      loading: "lazy",
                      fetchpriority: "low",
                      width: "400",
                      height: "400",
                      sizes,
                    },
                    image
                  )}
                  href={link}
                  {showTitle}
                  external={false}
                  name={name}
                >
                  <h3 class="card-title" set:html={name} />
                  <p class="card-description">{description}</p>
                </Card>
              );
            });
          }
        }
      </div>
    </div>
  </section>

  <section data-nav-section="contact" class="py-12">
    <div class="content text-center">
      <h2 id="contact">Contact.</h2>
    </div>
    <div class="container px-3 sm:px-5 max-w-[85ch]">
      <div
        class="flex flex-col gap-2 xsm:grid sm:grid-cols-3 sm:gap-6 justify-center overflow-x-auto"
      >
        {
          () => {
            let links = {
              LinkedIn: "https://www.linkedin.com/in/bghailu",
              GitHub: "https://github.com/bghailu",
              Email: "mailto:binighailu@gmail.com",
            };

            return Object.keys(links).map((name) => {
              let href = links[name as keyof typeof links];
              let rel = {};
              return (
                <Anchor
                  class={`px-4 py-2 hover:text-primary hover:bg-primary/30 focus:bg-primary/20 umami--click--${slugger(name, { lower: false })}-contact`}
                  href={href}
                  {...rel}
                >
                  {name}
                </Anchor>
              );
            });
          }
        }
      </div>
    </div>
  </section>
</HomepageLayout>

<style>
  @reference "../styles/global.css";

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply mt-0;
  }

  h1,
  h2 {
    @apply text-primary font-lexend font-[700];
  }

  h3,
  h4,
  h5,
  h6 {
    @apply font-manrope font-[400];
  }

  p {
    @apply lt-xsm:text-base lt-xsm:leading-relaxed;
  }
</style>

<script>
  import "../scripts/index.ts";
</script>
